rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ═══════════════════════════════════════════════════════════════════════════
    // STORAGE RULES — Fluix CRM
    //
    // LIMITACIÓN: Storage rules NO pueden consultar Firestore.
    // No es posible verificar empresa_id del usuario contra Firestore.
    // Se usa request.auth != null como mínimo + custom claims si disponibles.
    // Las rutas más sensibles (certificados) están bloqueadas: solo Admin SDK.
    // ═══════════════════════════════════════════════════════════════════════════

    // ── FUNCIÓN AUXILIAR ────────────────────────────────────────────────────
    // Verificar custom claim de empresa (si se implementa en el futuro)
    // function perteneceAEmpresa(empresaId) {
    //   return request.auth.token.empresa_id == empresaId;
    // }

    // ── RUTAS PÚBLICAS (catálogo web, logo, web content) ────────────────────

    // Zona pública de la empresa (logo, galería, productos, servicios)
    match /empresas/{empresaId}/public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Logo de la empresa — visible públicamente (para la web)
    match /empresas/{empresaId}/logo.jpg {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024  // max 5MB
        && request.resource.contentType.matches('image/.*');
    }

    // Catálogo de productos — lectura pública (widgets web, WordPress)
    match /empresas/{empresaId}/catalogo/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024  // max 10MB
        && request.resource.contentType.matches('image/.*');
    }

    // Catálogo web editorial (libros, autores — imágenes del CMS web)
    match /empresas/{empresaId}/catalogo_web/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Autores (fotos de autor para la web editorial)
    match /empresas/{empresaId}/autores/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Manuscritos enviados desde la web — lectura publica (getDownloadURL sin auth)
    match /manuscritos/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 25 * 1024 * 1024;
    }

    // Fotos de servicios del catálogo de servicios
    match /empresas/{empresaId}/servicios/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Imágenes de carta web (platos, bebidas)
    match /empresas/{empresaId}/carta/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Contenido web público (imágenes de secciones, blog, etc.)
    match /empresas/{empresaId}/web/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Imágenes de blog (ruta directa — compatible con todas las versiones del app)
    match /empresas/{empresaId}/blog/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── RUTAS PROTEGIDAS (solo usuarios autenticados) ───────────────────────

    // Documentos de empleados (foto, contratos, etc.)
    // Solo admin/propietario debería acceder — verificación completa en app
    match /empresas/{empresaId}/empleados/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024  // max 20MB
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }

    // Facturas (PDFs generados)
    match /empresas/{empresaId}/facturas/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // Documentos fiscales subidos por el usuario (facturas recibidas, tickets)
    // Solo el usuario autenticado puede subir; solo la Cloud Function (Admin SDK) lee
    match /empresas/{empresaId}/private/fiscal/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024  // max 25MB
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/.*'));
    }

    // Finiquitos (PDFs firmados)
    match /empresas/{empresaId}/finiquitos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // Nóminas (PDFs e imágenes) — el empleado puede leer las suyas, admin las de todos
    // NOTA: Storage rules no pueden filtrar por empleado_id.
    // La restricción real se aplica en Firestore (nominas rule) y en la app.
    match /empresas/{empresaId}/nominas/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/.*'));
    }

    // Adjuntos de tareas
    match /empresas/{empresaId}/tareas/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024; // max 50MB
    }

    // Contratos de empleados
    match /empresas/{empresaId}/private/contratos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // Documentos personales de usuarios (DNI, titulaciones...)
    match /empresas/{empresaId}/private/documentos_usuarios/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/.*'));
    }

    // Exports fiscales (PDFs y TXT generados por la app)
    match /empresas/{empresaId}/private/fiscal/exports/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024;
    }

    // Templates fiscales AEAT (PDFs oficiales rellenables)
    // Solo Cloud Functions (Admin SDK) puede escribir; usuarios pueden leer
    match /templates/fiscal/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Convenios (lectura para usuarios autenticados, solo Admin SDK escribe)
    match /convenios/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Plataforma (solo Admin SDK)
    match /plataforma/{allPaths=**} {
      allow read, write: if false;
    }

    // ── CERTIFICADOS DIGITALES — NUNCA accesibles desde el cliente ──────────
    // Solo Cloud Functions (Admin SDK) puede leer/escribir .p12/.pfx
    match /empresas/{empresaId}/certificados/{allPaths=**} {
      allow read, write: if false;
    }

    // ── NEGOCIOS PÚBLICOS — todas las subcarpetas accesibles públicamente ──────
    // Cubre: /{negocioId}/sitio/, /adicionales/, /galeria/, /servicios/, directo
    match /negocios_publicos/{negocioId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Avatares / fotos de perfil de usuarios — cualquier imagen bajo /usuarios/{uid}/
    match /usuarios/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // Ruta legacy avatar.jpg (compatibilidad)
    match /usuarios/{userId}/avatar.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Fotos de empleados — ruta usada por StorageService
    // Path: empleados/{empresaId}/{empleadoId}/foto.jpg
    match /empleados/{empresaId}/{empleadoId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Avatares de usuarios — ruta corta usada por pantalla_perfil_cliente
    match /avatares/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Imágenes de catálogo TPV subidas desde la app (SubirImagenesCatalogoScreen)
    match /empresas/{empresaId}/catalogo_imagenes/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Archivos ebook (PDF/EPUB) — solo escritura autenticada, lectura solo Admin SDK
    match /ebooks/{allPaths=**} {
      allow read: if false;   // solo Cloud Functions (Admin SDK) genera signed URLs
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType == 'application/epub+zip');
    }

    // Caché JS — lectura pública, escritura solo desde Fluix app (usuario autenticado)
    match /cache/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'application/javascript';
    }

    // Fluix Web SDK — JS auto-subido por la app, lectura pública para la web del cliente
    match /empresas/{empresaId}/fluix-sdk.js {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024; // max 2MB
    }

    // ── REGLA POR DEFECTO: denegar todo lo demás ────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

